type DigitalTaongaProposal = variant {
  UpdateDigitalTaonga : UpdateDigitalTaongaProposal;
  DeleteDigitalTaonga : nat64;
  CreateDigitalTaonga : record { text; text; text; nat64; text };
  RequestDownloadPermision;
};
type GuardianProposal = variant {
  RemoveFromDao : record { principal; nat64 };
  AssignAsObserver : record { principal; nat64 };
};
type LikeProposal = variant { Like; Dislike };
type Member = record {
  "principal" : principal;
  liked_proposals : vec record { nat; LikeProposal };
  name : opt text;
  role : MemberRole;
  created_at : nat64;
  last_activity : nat64;
  cover_img : text;
  profile_pic : text;
};
type MemberError = variant {
  NotFound;
  NotOnlyOneMember;
  MemberIsNotViewer;
  MemberIsNotPendingMember;
};
type MemberRole = variant {
  Viewer;
  PendingMember : MemberRole;
  Guardian;
  Admin;
  Voter;
  NFTCreator;
  Observer;
};
type MotionProposal = variant {};
type Proposal = record {
  id : nat;
  status : ProposalStatus;
  title : text;
  creator : principal;
  votes : vec record { principal; Vote };
  kind : ProposalType;
  description : text;
  deadline : nat64;
  created_at : nat64;
  likes : vec record { principal; LikeProposal };
  active_members : nat;
  comments : vec ProposalComment;
};
type ProposalComment = record {
  creator : principal;
  created_at : nat64;
  likes : nat64;
  comment : text;
  thread : Vec;
  dislikes : nat64;
};
type ProposalError = variant { LastAdmin; Closed; NotFound; Unauthorized };
type ProposalStatus = variant { Open; Review; Approved; Rejected; Voting };
type ProposalType = variant {
  Action : record { text; text; nat64 };
  Guardian : GuardianProposal;
  DigitalTaonga : DigitalTaongaProposal;
  Motion : MotionProposal;
};
type Result = variant { Ok : Member; Err : MemberError };
type Result_1 = variant { Ok : vec principal; Err : MemberError };
type Result_2 = variant { Ok : Proposal; Err : ProposalError };
type UpdateDigitalTaongaProposal = variant {
  UpdateImageURL : text;
  UpdateDescription : text;
};
type Vec = vec record {
  creator : principal;
  created_at : nat64;
  likes : nat64;
  comment : text;
  thread : Vec;
  dislikes : nat64;
};
type Vote = variant { Approve; Abstain; Disapprove };
service : () -> {
  accept_member_invitation : () -> (Result);
  add_owner : (principal) -> ();
  batch_update_member_role : (vec principal, MemberRole) -> (Result_1);
  check_proposal_status : (nat) -> (Result_2);
  create_member : () -> (Member);
  create_proposal : (text, text, ProposalType, nat64) -> (Proposal);
  edit_member : (opt text, opt text, opt text) -> (Result);
  edit_proposal : (nat, text, text, ProposalType) -> (opt Proposal);
  get_active_members : () -> (vec Member) query;
  get_all_members : () -> (vec Member) query;
  get_all_proposals : () -> (vec Proposal) query;
  get_member : (principal) -> (Result) query;
  get_proposal : (nat) -> (opt Proposal) query;
  get_proposals_by_member : (principal) -> (vec Proposal) query;
  has_voted : (nat) -> (opt Vote) query;
  like_proposal : (nat, LikeProposal) -> ();
  new_comment_proposal : (nat, text) -> ();
  reject_member_invitation : () -> (Result);
  remove_owner : (principal) -> ();
  set_last_activity_member : () -> ();
  test_approve_proposal : (nat) -> ();
  test_mint_asset_digital : (
      principal,
      principal,
      text,
      text,
      text,
      text,
      text,
      opt text,
    ) -> ();
  test_reject_proposal : (nat) -> (Result_2);
  vote_proposal : (nat, Vote) -> (Result_2);
}
