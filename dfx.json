{
  "canisters": {
    "dao": {
      "candid": "src/dao/dao.did",
      "package": "dao",
      "type": "rust"
    },
 
    "motokoDao": {
      "main": "src/dao/main.mo",
      "type": "motoko",
      "declarations": {
        "output": "./src/frontend/declarations/backend"
      }
    },

    "taonga" : {
      "main": "src/dao/taonga/taonga.mo",
      "type": "motoko",
      "declarations": {
        "output": "./src/frontend/declarations/backend/taonga"
      }
    },

    "digital_asset": {
      "candid": "src/digital_asset/digital_asset.did",
      "package": "digital_asset",
      "type": "rust"
    },
    "frontend": {
      "source": [
        "src/frontend/dist"
      ],
      "type": "assets",
      "workspace": "frontend"
    },
    "frontend-dev": {
      "source": [
        "src/frontend/dist"
      ],
      "type": "assets",
      "workspace": "frontend"
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": "mops sources"
    }
  },
  "output_env_file": ".env",
  "version": 1
}